{
  "name": "nba-france-stats",
  "version": "1.0.0",
  "description": "Site de suivi des performances des joueurs français en NBA",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon server/index.js",
    "dev:client": "cd client && npm start",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "test": "jest"
  },
  "keywords": [
    "NBA",
    "France",
    "Basketball",
    "Statistics"
  ],
  "author": "fredericcaduc",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "node-schedule": "^2.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.1",
    "jest": "^29.7.0"
  }
}
